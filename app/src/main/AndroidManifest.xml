<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 应用清单的根节点。 xmlns:android="http://schemas.android.com/apk/res/android"：声明 android 属性前缀对应的 XML 命名空间，后续 android: 属性依靠它解析。 > 表示起始标签结束，接下来可放子节点。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      声明应用级属性；其中包含页面等组件。
      android:allowBackup="false"：false 表示关闭系统应用备份。
      android:label="@string/app_name"：引用 strings.xml 中的 app_name 作为应用名称。
      android:supportsRtl="true"：true 表示声明支持从右向左的布局方向。
      android:theme="@style/Theme.LearningApp"：使用 values/themes.xml 中定义的应用主题。 > 表示起始标签结束，接下来可放子节点。
    -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LearningApp">
        <!-- MAIN + LAUNCHER 表示点击桌面图标时打开这个页面。 -->
        <!--
          注册 Activity 页面。
          android:name=".feature.home.ui.MainActivity"：组件名或动作名；.feature.home.ui.MainActivity 指 namespace 下 feature.home.ui 包中的页面类，MAIN 表示主入口，LAUNCHER 表示桌面启动类别。
          android:exported="true"：true 表示允许应用外部启动这个页面，桌面启动器需要此设置。 > 表示起始标签结束，接下来可放子节点。
        -->
        <activity
            android:name=".feature.home.ui.MainActivity"
            android:exported="true">
            <!--
              声明这个页面能够响应的启动意图。 > 表示起始标签结束，接下来可放子节点。
            -->
            <intent-filter>
                <!--
                  声明意图动作。 android:name="android.intent.action.MAIN"：组件名或动作名；.feature.home.ui.MainActivity 指 namespace 下 feature.home.ui 包中的页面类，MAIN 表示主入口，LAUNCHER 表示桌面启动类别。 /> 表示这个节点在此处结束，没有子节点。
                -->
                <action android:name="android.intent.action.MAIN" />
                <!--
                  声明意图类别。 android:name="android.intent.category.LAUNCHER"：组件名或动作名；.feature.home.ui.MainActivity 指 namespace 下 feature.home.ui 包中的页面类，MAIN 表示主入口，LAUNCHER 表示桌面启动类别。 /> 表示这个节点在此处结束，没有子节点。
                -->
                <category android:name="android.intent.category.LAUNCHER" />
            <!-- 结束 intent-filter 节点。 -->
            </intent-filter>
        <!-- 结束 activity 节点。 -->
        </activity>
    <!-- 结束 application 节点。 -->
    </application>
<!-- 结束 manifest 节点。 -->
</manifest>
